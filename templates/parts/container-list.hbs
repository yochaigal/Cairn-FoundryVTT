<div class="cairn-items-list-header">
    <div>{{ localize 'CAIRN.Name' }}</div>
    <a class="item-control container-create" data-action="containerCreate" title="{{ localize 'CAIRN.CreateContainer' }}"><i class="fas fa-plus"></i>&nbsp;{{ localize 'CAIRN.AddContainer' }}</a>
</div>
{{#each system.containerObjects as |ctr|}}
<div class="cairn-items-list-row" data-item-id="{{ctr.uuid}}" data-is-container="true" draggable="true">
    <div class="cairn-items-list-row-header">
        <div class="cairn-item-name-and-tags">
            <a class="cairn-item-title" data-action="itemToggle">{{ctr.name}} ({{ctr.system.slotsUsed}}/{{ctr.system.slots.value}})</a>
        </div>
        <div class="cairn-item-controls">
            <a class="item-control item-edit" data-action="itemEdit" title="{{ localize 'CAIRN.EditItem' }}"><i class="fas fa-edit"></i></a>
            <a class="item-control item-delete" data-action="itemDelete" title="{{ localize 'CAIRN.DeleteItem' }}"><i class="fas fa-trash"></i></a>
        </div>
    </div>
</div>
{{/each}}
