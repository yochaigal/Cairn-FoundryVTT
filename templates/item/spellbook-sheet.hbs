<div class="item-sheet-grid spellbook">
    <div class="item-sheet-section-portrait">
        <img class="portrait" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
    </div>
    <div class="item-sheet-section-name">
        <input class="name-input" type="text" name="name" value="{{item.name}}" placeholder="{{ localize 'CAIRN.Name' }}" />
    </div>
        <div class="resource-counter long-counter">
            <label class="large-resource-label" for="system.equipped">{{ localize 'CAIRN.Equipped' }}</label>
            <div class="resource-input-wrapper">
                <input type="checkbox" {{checked system.equipped}} name="system.equipped" id="system.equipped" {{disabled (not system.isEquipable)}} />
            </div>
        </div>
        <div class="resource-counter long-counter">
            <label class="large-resource-label" for="system.quantity">{{ localize 'CAIRN.Quantity' }}</label>
            <div class="resource-input-wrapper">
                <input type="number" name="system.quantity" id="system.quantity" value="{{system.quantity}}" />
            </div>
        </div>
        <div class="resource-counter long-counter">
            <label class="large-resource-label" for="system.cost.value">{{ localize 'CAIRN.Cost' }}</label>
            <div class="resource-input-wrapper">
                <input type="number" name="system.cost.value" id="system.cost.value" value="{{system.cost.value}}" />
            </div>
        </div>
    <div class="item-sheet-section-tabs">
        <nav class="tabs" data-group="primary">
            <a class="item {{tabs.description.cssClass}}" data-action="vttforgeTab" data-group="primary" data-tab="description">{{ localize 'CAIRN.Description' }}</a>
            <a class="item {{lookup (lookup tabs 'crit-dmg') 'cssClass'}}" data-action="vttforgeTab" data-group="primary" data-tab="crit-dmg">{{ localize 'CAIRN.CriticalDamage' }}</a>
        </nav>
        <section class="content">
            <div class="tab {{tabs.description.cssClass}}" data-group="primary" data-tab="description">
                {{> "systems/cairn/templates/parts/editor.hbs" name="system.description" value=system.description enriched=enrichedDescription editable=isEditable}}
            </div>
            <div class="tab {{lookup (lookup tabs 'crit-dmg') 'cssClass'}}" data-group="primary" data-tab="crit-dmg">
                {{> "systems/cairn/templates/parts/editor.hbs" name="system.criticalDamage" value=system.criticalDamage enriched=enrichedCriticalDamage editable=isEditable}}
            </div>
        </section>
    </div>
</div>
