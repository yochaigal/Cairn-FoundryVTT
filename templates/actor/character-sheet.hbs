{{!-- No <form>: the sheet element already is one. --}}
<div class="charater-sheet-grid">
    <img class="portrait" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
    <div class="character-sheet-section-name">
        <input class="name-input" type="text" name="name" value="{{actor.name}}" placeholder="{{ localize 'CAIRN.Name' }}" />
        <input class="background-input" type="text" name="system.background" value="{{system.background}}" placeholder="{{ localize 'CAIRN.Background' }}" />
        <div class="resource-counter hp-counter">
            <label for="system.hp.value">{{ localize 'CAIRN.HitProtection' }}</label>
            <div class="resource-input-wrapper">
                <input type="number" name="system.hp.value" id="system.hp.value" value="{{system.hp.value}}" />
                <span> / </span>
                <input type="number" name="system.hp.max" value="{{system.hp.max}}" />
            </div>
        </div>
        <div class="resource-counter deprived-counter middle-counter {{#if system.maybeTooMuchGold}}overburdened-gold{{/if}}" {{#if system.maybeTooMuchGold}}title="{{localize 'CAIRN.OverburdenByGold'}}"{{/if}}>
            <label for="system.gold">{{ localize 'CAIRN.Gold' }}</label>
            <div class="resource-input-wrapper">
                <input type="number" name="system.gold" id="system.gold" value="{{system.gold}}" />
            </div>
        </div>
    </div>
    <div class="character-sheet-section-buttons">
        <button type="button" class="strict-size-button" data-action="rest" {{#if system.deprived}}disabled{{/if}}>{{ localize 'CAIRN.Rest' }}</button>
        <button type="button" class="strict-size-button" data-action="restoreAbilities" {{#if system.deprived}}disabled{{/if}}>{{ localize 'CAIRN.RestoreAbilities' }}</button>
        <button type="button" class="strict-size-button" data-action="dieOfFate">{{ localize 'CAIRN.DieOfFate' }}</button>
    </div>
    <div class="character-sheet-section-abilities">
        {{#each system.abilities as |ability key|}}
        <div class="resource-counter {{key}}-counter">
            <a class="resource-roll" data-action="rollAbility" data-roll="d20cs<=@abilities.{{key}}.value" data-label="{{{ localize 'CAIRN.Save' key=key}}}">{{ localize key }}</a>
            <div class="resource-input-wrapper">
                <input type="number" name="system.abilities.{{key}}.value" value="{{ability.value}}" />
                <span> / </span>
                <input type="number" name="system.abilities.{{key}}.max" value="{{ability.max}}" />
            </div>
        </div>
        {{/each}}
    </div>
    <div class="character-sheet-section-others">
        <div class="resource-counter long-counter">
            <label>{{ localize 'CAIRN.Armor' }}</label>
            <div class="resource-input-wrapper"><span>{{system.armor}}</span></div>
        </div>
        <div class="resource-counter long-counter deprived-counter">
            <label for="system.deprived">{{ localize 'CAIRN.Deprived' }}</label>
            <div class="resource-input-wrapper">
                <input type="checkbox" {{checked system.deprived}} name="system.deprived" id="system.deprived" />
            </div>
        </div>
        {{#if system.usePanic}}
        <div class="resource-counter long-counter deprived-counter">
            <label for="system.panicked">{{ localize 'CAIRN.Panicked' }}</label>
            <div class="resource-input-wrapper">
                <input type="checkbox" {{checked system.panicked}} name="system.panicked" id="system.panicked" />
            </div>
        </div>
        {{/if}}
    </div>
    <div class="character-sheet-section-tabs">
        <nav class="tabs" data-group="primary">
            <a class="item {{tabs.items.cssClass}}" data-action="vttforgeTab" data-group="primary" data-tab="items">
                {{#if system.characterEquipmentLimit}}<i class="fas fa-gears" style="opacity:0.5" data-action="setEquipmentLimit" title="Double click to change limit"></i>{{/if}}
                {{ localize 'CAIRN.Items' }} ({{system.slotsUsed}} / {{system.slotsMax}})
            </a>
            <a class="item {{tabs.containers.cssClass}}" data-action="vttforgeTab" data-group="primary" data-tab="containers">{{ localize 'CAIRN.Containers' }} ({{system.containers.length}})</a>
            <a class="item {{tabs.description.cssClass}}" data-action="vttforgeTab" data-group="primary" data-tab="description">{{ localize 'CAIRN.Description' }}</a>
            <a class="item {{tabs.notes.cssClass}}" data-action="vttforgeTab" data-group="primary" data-tab="notes">{{ localize 'CAIRN.Notes' }}</a>
        </nav>
        <section class="content">
            <div class="tab {{tabs.items.cssClass}}" data-group="primary" data-tab="items">
                {{> "systems/cairn/templates/parts/items-list.hbs" withFatigue=1}}
            </div>
            <div class="tab {{tabs.containers.cssClass}}" data-group="primary" data-tab="containers">
                {{> "systems/cairn/templates/parts/container-list.hbs"}}
            </div>
            <div class="tab {{tabs.description.cssClass}}" data-group="primary" data-tab="description">
                <div class="description">
                    {{#if system.showFeatures}}
                    <div class="features">{{> "systems/cairn/templates/parts/feature-list.hbs"}}</div>
                    {{/if}}
                    {{> "systems/cairn/templates/parts/editor.hbs" name="system.biography" value=system.biography enriched=enrichedBiography editable=isEditable}}
                </div>
            </div>
            <div class="tab {{tabs.notes.cssClass}}" data-group="primary" data-tab="notes">
                {{> "systems/cairn/templates/parts/editor.hbs" name="system.notes" value=system.notes enriched=enrichedNotes editable=isEditable}}
            </div>
        </section>
    </div>
</div>
